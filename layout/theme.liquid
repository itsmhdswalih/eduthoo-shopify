<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if page_title != blank %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700;1,900&family=Bodoni+Moda:ital,opsz,wght@0,6..96,600..900;1,6..96,700&display=swap" rel="stylesheet">
    {{ 'eduthoo-theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'eduthoo-theme.js' | asset_url }}" defer="defer"></script>
  </head>
  <body class="template-{{ request.page_type | handle }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
      <!-- AJAX Cart Drawer -->
    <div id="ed-cart-drawer" class="ed-cart-drawer" aria-hidden="true">
      <div class="ed-cart-drawer-overlay" data-cart-close></div>
      <div class="ed-cart-drawer-content">
        <div class="ed-cart-drawer-header">
          <h2>Your Cart</h2>
          <button type="button" class="ed-cart-drawer-close" data-cart-close aria-label="Close cart">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <div class="ed-cart-drawer-body" id="ed-cart-drawer-body">
          <div class="ed-cart-drawer-empty">Loading...</div>
        </div>
        <div class="ed-cart-drawer-footer">
          <div class="ed-cart-drawer-subtotal">
            <span>Subtotal</span>
            <span id="ed-cart-drawer-total">₹0</span>
          </div>
          <p class="ed-cart-drawer-tax">Shipping & taxes calculated at checkout</p>
          <a href="/checkout" class="ed-button" style="width: 100%;">CHECKOUT</a>
        </div>
      </div>
    </div>
  <style>
/* NUKING JUDGE.ME DEFAULTS */
body .jdgm-widget, body .jdgm-rev-widg {
  --jdgm-primary-color: #000000 !important;
  --jdgm-secondary-color: #000000 !important;
}
body .jdgm-rev-widg__title {
  font-size: clamp(28px, 6vw, 42px) !important;
  font-weight: 900 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.03em !important;
  text-align: center !important;
  margin-bottom: 24px !important;
  color: #000 !important;
  display: block !important;
}
body .jdgm-widget a.jdgm-write-rev-link,
body .jdgm-widget input.jdgm-submit-rev,
body .jdgm-widget .jdgm-btn,
body a.jdgm-write-rev-link {
  background-color: #000000 !important;
  color: #ffffff !important;
  border-radius: 50px !important;
  padding: 18px 48px !important;
  font-size: 18px !important;
  font-weight: 800 !important;
  border: none !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  box-shadow: 0 10px 24px rgba(0,0,0,0.15) !important;
  display: inline-block !important;
  margin: 15px auto !important;
  text-align: center !important;
}
body .jdgm-widget-actions {
  text-align: center !important;
  width: 100% !important;
  display: block !important;
}
body .jdgm-star { color: #000000 !important; }
body .jdgm-row-stars { font-size: 16px !important; font-weight: 500 !important; display: block !important; text-align: center !important; }
</style>
</body>
</html>


