{% assign related_collection = section.settings.collection %}
{% assign display_products = related_collection.products %}

{% if display_products == blank or display_products.size == 0 %}
  {% assign display_products = collections.all.products | sort: 'published_at' | reverse %}
{% endif %}

<section class="ed-section" style="background-color: #fafafa; border-top: 1px solid var(--ed-line);">
  <div class="ed-container">
    <div class="ed-section-heading" style="text-align: center; margin-bottom: 40px;">
      <p style="font-size: 11px; letter-spacing: 0.12em; font-weight: 800; color: #555;">{{ section.settings.eyebrow | escape }}</p>
      <h2 style="font-family: var(--font-serif); font-size: 32px; font-weight: 900; margin-top: 12px;">{{ section.settings.heading | escape }}</h2>
    </div>
    
    <div class="ed-product-grid">
      {% for product in display_products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        <!-- Fallback if absolutely 0 products exist in the store -->
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: #fff; border: 1px dashed #ccc;">
          <p>No products found. Add products in your Shopify Admin to see them here.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EXPLORE MORE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "collection", "id": "collection", "label": "Collection to pull from" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Related Products" }]
}
{% endschema %}
