{% assign related_collection = section.settings.collection %}
<section class="ed-section" style="background-color: #fafafa; border-top: 1px solid var(--ed-line);">
  <div class="ed-container">
    <div class="ed-section-heading" style="text-align: center; margin-bottom: 40px;">
      <p style="font-size: 11px; letter-spacing: 0.12em; font-weight: 800; color: #555;">{{ section.settings.eyebrow | escape }}</p>
      <h2 style="font-family: var(--font-serif); font-size: 32px; font-weight: 900; margin-top: 12px;">{{ section.settings.heading | escape }}</h2>
    </div>
    
    {% if related_collection != blank and related_collection.products.size > 0 %}
      <div class="ed-product-grid">
        {% for product in related_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <!-- Fallback Demo Products -->
      <div class="ed-product-grid ed-product-grid--preview">
        <article class="ed-product-card">
          <a href="{{ routes.all_products_collection_url }}" class="ed-product-card__image">
            <img src="{{ 'eduthoo-earbuds.jpg' | asset_url }}" alt="EDUTHOO Pro ANC Wireless Earbuds" width="400" height="400" loading="lazy">
            <b>BEST SELLER</b>
          </a>
          <div class="ed-product-card__content">
            <p>GADGETS</p>
            <h3><a href="{{ routes.all_products_collection_url }}">EDUTHOO Pro ANC Wireless Earbuds</a></h3>
            <strong>₹1,999 <s>₹2,999</s></strong>
            <a href="{{ routes.all_products_collection_url }}" class="ed-card-button">
              VIEW OPTIONS 
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
        
        <article class="ed-product-card">
          <a href="{{ routes.all_products_collection_url }}" class="ed-product-card__image">
            <img src="{{ 'eduthoo-magsafe-stand.jpg' | asset_url }}" alt="EDUTHOO MagSafe stand" width="400" height="400" loading="lazy">
            <b>TRENDING</b>
          </a>
          <div class="ed-product-card__content">
            <p>TECH</p>
            <h3><a href="{{ routes.all_products_collection_url }}">EDUTHOO MagSafe 3-in-1 Aluminum Stand</a></h3>
            <strong>₹2,499 <s>₹3,499</s></strong>
            <a href="{{ routes.all_products_collection_url }}" class="ed-card-button">
              VIEW OPTIONS 
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>

        <article class="ed-product-card">
          <a href="{{ routes.all_products_collection_url }}" class="ed-product-card__image">
            <img src="{{ 'eduthoo-smart-light.jpg' | asset_url }}" alt="EDUTHOO Smart Ambient Lamp" width="400" height="400" loading="lazy">
            <b>NEW</b>
          </a>
          <div class="ed-product-card__content">
            <p>HOME</p>
            <h3><a href="{{ routes.all_products_collection_url }}">EDUTHOO Smart Cylindrical Ambient Lamp</a></h3>
            <strong>₹1,499 <s>₹2,199</s></strong>
            <a href="{{ routes.all_products_collection_url }}" class="ed-card-button">
              VIEW OPTIONS 
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>

        <article class="ed-product-card">
          <a href="{{ routes.all_products_collection_url }}" class="ed-product-card__image">
            <img src="{{ 'eduthoo-keyboard.jpg' | asset_url }}" alt="EDUTHOO Wireless Keyboard" width="400" height="400" loading="lazy">
            <b>FLAGSHIP</b>
          </a>
          <div class="ed-product-card__content">
            <p>TECH</p>
            <h3><a href="{{ routes.all_products_collection_url }}">EDUTHOO Low-Profile Wireless Keyboard</a></h3>
            <strong>₹3,999 <s>₹5,499</s></strong>
            <a href="{{ routes.all_products_collection_url }}" class="ed-card-button">
              VIEW OPTIONS 
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EXPLORE MORE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "collection", "id": "collection", "label": "Collection to pull from" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Related Products" }]
}
{% endschema %}
