<style>
  .ed-faq-section details > summary { list-style: none; }
  .ed-faq-section details > summary::-webkit-details-marker { display: none; }
  .ed-faq-section details[open] summary svg {
    transform: rotate(45deg) !important;
  }
</style>
<section class="ed-section ed-faq-section" style="padding-bottom: 60px;">
  <div class="ed-container" style="max-width: 760px; margin: 0 auto;">
    <div class="ed-section-heading ed-section-heading--center" style="margin-bottom: 40px;">
      <h2 style="font-size: clamp(24px, 5vw, 36px); font-weight: 900; margin: 0;">{{ section.settings.heading }}</h2>
    </div>
    <div class="ed-accordion">
      {% for block in section.blocks %}
        <details class="ed-policy-card" {{ block.shopify_attributes }}>
          <summary class="ed-acc-trigger" style="display: flex; align-items: center; justify-content: space-between; padding: 24px 32px; cursor: pointer; list-style: none;">
            <h3 style="font-size: 16px; margin: 0; font-weight: 800; letter-spacing: 0.03em; flex: 1; padding-right: 16px;">{{ block.settings.question }}</h3>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transition: transform 0.3s ease; flex-shrink: 0;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </summary>
          <div class="ed-accordion__content" style="padding: 0 32px 24px; font-size: 14px; color: #555; line-height: 1.6;">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide the answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day hassle-free return policy. If you are not completely satisfied with your smart essentials, simply contact us for a full refund or exchange.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>All orders are processed within 24-48 hours. Standard delivery takes 5-10 business days depending on your location. Tracking details will be emailed to you.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How can I contact customer support?",
            "answer": "<p>You can reach our support team directly through our <strong>Contact Us page</strong> or via WhatsApp. We are always here to help!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

