<footer class="site-footer">
  <div class="ed-container ed-footer-grid">
    <div>
      <h2>{{ shop.name }}</h2>
      <p>{{ section.settings.description }}</p>
      
      <div style="margin-top: 24px;">
        <h3 style="font-size: 11px; letter-spacing: 0.1em; color: #777; margin-bottom: 8px;">CUSTOMER CARE</h3>
        <p style="font-size: 14px; margin: 0; font-weight: 500;">
          <a href="mailto:eduthooo@gmail.com" style="color: #fff; text-decoration: underline; text-underline-offset: 4px;">eduthooo@gmail.com</a>
        </p>
        <p style="font-size: 12px; margin-top: 8px; color: #888;">We'll respond within 24 hours.</p>
      </div>
    </div>
    <div>
      <h3>Menu</h3>
      {% if section.settings.menu.links == blank %}<a href="/pages/about-us">About Us</a><a href="/pages/contact">Contact Us</a><a href="/policies/privacy-policy">Privacy Policy</a><a href="/policies/refund-policy">Refund Policy</a><a href="/policies/shipping-policy">Shipping Policy</a><a href="/policies/terms-of-service">Terms of Service</a>{% else %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% endif %}
    </div>
  </div>
  <div class="ed-container ed-footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span>Developed & managed by <a href="https://www.instagram.com/sw4_lih___/?utm_source=ig_web_button_share_sheet" target="_blank" style="text-decoration: underline;">Muhammad Swalih</a> & <a href="https://www.instagram.com/ajmalmuhammad._?utm_source=ig_web_button_share_sheet&amp;stkn=ZDNlZDc0MzIxNw==" target="_blank" style="text-decoration: underline;">Ajmal Muhammad</a></span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "Smart gadgets, useful technology and everyday essentials for modern living." },
    { "type": "link_list", "id": "menu", "label": "Footer menu" }
  ]
}
{% endschema %}


