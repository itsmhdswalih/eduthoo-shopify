<header class="site-header">
  <div class="ed-container ed-header-grid">
    <nav class="ed-nav" aria-label="Primary navigation">
      {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">SHOP</a><a href="{{ routes.all_products_collection_url }}">GADGETS</a><a href="{{ routes.all_products_collection_url }}">TECH</a><a href="{{ routes.all_products_collection_url }}">HOME</a><a href="{{ routes.all_products_collection_url }}">TRENDING</a>{% endif %}
    </nav>
    <a class="ed-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if settings.logo != blank %}
        <span style="width: {{ settings.logo_width }}px;">{{ settings.logo | image_url: width: 192 | image_tag: widths: '64,96,128,192', alt: shop.name }}</span>
      {% else %}
        <span class="ed-logo-fallback">{{ shop.name | escape }}</span>
      {% endif %}
    </a>
    <div class="ed-header-actions">
      <form action="{{ routes.search_url }}" method="get" class="ed-header-inline-search"><input type="text" name="q" placeholder="Search..." aria-label="Search" class="ed-header-search-input"><button type="submit" aria-label="Submit Search" class="ed-header-search-btn"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg></button></form>
      <a href="{{ routes.account_url }}" aria-label="Account" class="ed-icon-link"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"></circle><path d="M4 21c.8-4 3.5-6 8-6s7.2 2 8 6"></path></svg></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items" class="ed-icon-link" onclick="event.preventDefault(); document.getElementById('ed-cart-drawer').classList.add('is-open'); window.dispatchEvent(new Event('ed-cart-update'));"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14l-1 14H6L5 7Z"></path><path d="M9 8V5a3 3 0 0 1 6 0v3"></path></svg>{% if cart.item_count > 0 %}<b>{{ cart.item_count }}</b>{% endif %}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]
}
{% endschema %}



