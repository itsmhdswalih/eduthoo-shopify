<header class="site-header">
  <div class="ed-container ed-header-grid">
    <nav class="ed-nav" aria-label="Primary navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {% endfor %}
    </nav>
    <a class="ed-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if settings.logo != blank %}
        <span style="width: {{ settings.logo_width }}px;">{{ settings.logo | image_url: width: 192 | image_tag: widths: '64,96,128,192', alt: shop.name }}</span>
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>
    <div class="ed-header-actions">
      <a href="{{ routes.search_url }}" aria-label="Search">Search</a>
      <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]
}
{% endschema %}
