<section class="ed-hero" style="position: relative; overflow: hidden; padding-bottom: 80px;">
  <div class="ed-container" style="text-align: center; padding-top: 60px;">
    
    <!-- Hero Text -->
    <div class="ed-hero-copy" style="max-width: 800px; margin: 0 auto 60px;">
      <p class="ed-eyebrow" style="margin-bottom: 16px; font-size: 11px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: #555;">{{ section.settings.eyebrow | escape }}</p>
      
      <h1 class="ed-hero-title-bento" style="font-family: var(--font-serif); font-size: clamp(36px, 6vw, 64px); font-weight: 900; line-height: 1.1; letter-spacing: -0.02em; color: #000; text-transform: capitalize; margin-bottom: 16px;">
        {{ section.settings.heading | escape }}
      </h1>
      
      {% if section.settings.text != blank %}
      <div class="rte" style="max-width: 600px; margin: 0 auto; font-size: 16px; color: #555; line-height: 1.6;">
        {{ section.settings.text }}
      </div>
      {% endif %}
    </div>

    <!-- Bento Grid -->
    <div class="ed-bento-grid" style="display: grid; grid-template-columns: 1fr 1.1fr 1.1fr 1fr; gap: 16px; max-width: 1100px; margin: 0 auto;">
      
      <!-- Column 1 -->
      <div class="ed-bento-col" style="display: flex; flex-direction: column; gap: 16px;">
        <img class="bento-img-1" src="{{ 'hero_tech_1.jpg' | asset_url }}" alt="Smart Tech" style="width: 100%; height: 280px; object-fit: cover; border-radius: 40px 40px 16px 40px;">
        <img class="bento-img-2" src="{{ 'hero_tech_2.jpg' | asset_url }}" alt="Earbuds" style="width: 100%; height: 180px; object-fit: cover; border-radius: 16px 40px 40px 40px;">
      </div>

      <!-- Column 2 -->
      <div class="ed-bento-col ed-bento-push-down-1" style="display: flex; flex-direction: column; gap: 16px; margin-top: 48px;">
        <img class="bento-img-3" src="{{ 'hero_tech_3.jpg' | asset_url }}" alt="Smart Watch" style="width: 100%; height: 100%; min-height: 360px; object-fit: cover; border-radius: 40px 16px 40px 16px;">
      </div>

      <!-- Column 3 -->
      <div class="ed-bento-col" style="display: flex; flex-direction: column; gap: 16px;">
        <img class="bento-img-4" src="{{ 'hero_tech_5.jpg' | asset_url }}" alt="Modern Tech" style="width: 100%; height: 260px; object-fit: cover; border-radius: 16px 40px 16px 40px;">
        
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="ed-bento-btn" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 64px; background: #000; color: #fff; text-decoration: none; border-radius: 50px; font-weight: 800; font-size: 14px; letter-spacing: 0.05em; transition: transform 0.3s ease, background 0.3s ease;">
          {{ section.settings.button_label | escape }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="10 5 19 5 19 14"></polyline></svg>
        </a>
      </div>

      <!-- Column 4 -->
      <div class="ed-bento-col ed-bento-push-down-2" style="display: flex; flex-direction: column; gap: 16px; margin-top: 24px;">
        <img class="bento-img-5" src="{{ 'hero_tech_4.jpg' | asset_url }}" alt="Power Bank" style="width: 100%; height: 100%; min-height: 320px; object-fit: cover; border-radius: 40px 40px 40px 16px;">
      </div>

    </div>
  </div>
</section>

<style>
  .ed-bento-btn:hover {
    transform: translateY(-4px);
    background: #222;
  }
  @media (max-width: 749px) {
    .ed-hero-title-bento { font-size: 36px !important; line-height: 1.15; }
    
    /* Make the grid compact on mobile */
    .ed-bento-grid { grid-template-columns: 1fr 1fr !important; gap: 10px !important; }
    .ed-bento-col { gap: 10px !important; }
    
    /* Drastically reduce heights so it's not cluttered */
    .bento-img-1 { height: 140px !important; border-radius: 20px 20px 8px 20px !important; }
    .bento-img-2 { height: 100px !important; border-radius: 8px 20px 20px 20px !important; }
    .bento-img-3 { height: 250px !important; min-height: unset !important; border-radius: 20px 8px 20px 8px !important; }
    .bento-img-4 { height: 150px !important; border-radius: 8px 20px 8px 20px !important; }
    .bento-img-5 { height: 200px !important; min-height: unset !important; border-radius: 20px 20px 20px 8px !important; }
    
    /* Reorder and adjust spacing */
    .ed-bento-push-down-1 { margin-top: 16px !important; }
    .ed-bento-push-down-2 { margin-top: 0 !important; }
    .ed-bento-col:nth-child(3) { order: 4; margin-top: 8px !important; }
    .ed-bento-col:nth-child(4) { order: 3; }
    
    /* Make button fit mobile perfectly */
    .ed-bento-btn { height: 50px !important; font-size: 13px !important; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CURATED ESSENTIALS FOR MODERN LIVING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevate Your Life With Smart Essentials" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Collections" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
