<section class="ed-hero" style="position: relative; overflow: visible;">
  
  <div class="ed-floating-items-container">
    <div class="ed-floating-wrapper" data-parallax-speed="0.15" style="position: absolute; top: 60%; left: 5%;">
      <img src="{{ 'floating-1.jpg' | asset_url }}" class="ed-floating-item ed-float-1" alt="Gadget 1">
    </div>
    <div class="ed-floating-wrapper" data-parallax-speed="-0.1" style="position: absolute; top: 10%; left: 50%; margin-left: -75px;">
      <img src="{{ 'floating-2.jpg' | asset_url }}" class="ed-floating-item ed-float-2" alt="Gadget 2">
    </div>
    <div class="ed-floating-wrapper" data-parallax-speed="0.2" style="position: absolute; top: 50%; right: 5%;">
      <img src="{{ 'floating-3.jpg' | asset_url }}" class="ed-floating-item ed-float-3" alt="Gadget 3">
    </div>
  </div>

  <div class="ed-container ed-hero-content" style="grid-template-columns: 1fr; text-align: center; position: relative; z-index: 2; padding-top: 100px; padding-bottom: 100px;">
    <div class="ed-hero-copy" style="max-width: 800px; margin: 0 auto;">
      <p class="ed-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <div class="ed-hero-title-wrap" style="justify-content: center;">
        <h1 class="ed-hero-title ed-dancing-letters" data-dancing-letters="{{ section.settings.heading | default: 'eduthoo' | escape }}" aria-label="{{ section.settings.heading | default: 'eduthoo' | escape }}">
          {% assign heading_chars = section.settings.heading | default: 'eduthoo' | split: '' %}
          {% for char in heading_chars %}
            <span class="ed-dancing-letter" data-letter-index="{{ forloop.index0 }}">{{ char }}</span>
          {% endfor %}
        </h1>
      </div>
      <div class="rte" style="margin-left: auto; margin-right: auto; max-width: 600px;">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}<a class="ed-button ed-button--dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✨ SMART THINGS FOR EVERYDAY LIFE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "eduthoo" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover smart gadgets, useful products and everyday essentials — all curated in one minimalist space.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW →" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
