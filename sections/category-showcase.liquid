{% capture category_cards %}
  <a href="{{ routes.all_products_collection_url }}" class="ed-category-card-custom"><div class="ed-video-wrapper"><video src="{{ 'eduthoo-category-gadgets.mp4' | asset_url }}" autoplay loop muted playsinline></video></div><div><h3>GADGETS</h3><p>Smart gadgets for everyday life.</p><span>SHOP GADGETS &rarr;</span></div></a>
  <a href="{{ routes.all_products_collection_url }}" class="ed-category-card-custom"><div class="ed-video-wrapper"><video src="{{ 'eduthoo-category-tech.mp4' | asset_url }}" autoplay loop muted playsinline></video></div><div><h3>TECH</h3><p>Useful technology and desk accessories.</p><span>SHOP TECH &rarr;</span></div></a>
  <a href="{{ routes.all_products_collection_url }}" class="ed-category-card-custom"><div class="ed-video-wrapper"><video src="{{ 'eduthoo-category-home.mp4' | asset_url }}" autoplay loop muted playsinline></video></div><div><h3>HOME</h3><p>Smart, useful products for modern spaces.</p><span>SHOP HOME &rarr;</span></div></a>
{% endcapture %}

<section class="ed-section ed-category-section" style="padding-bottom: 40px; overflow: hidden;">
  <div class="ed-container">
    <div class="ed-section-heading ed-section-heading--center">
      <p style="margin-bottom:8px; font-size:11px; font-weight:800; letter-spacing:.15em; color:#555;">DISCOVER BY SPACE</p>
      <h2 style="font-size:clamp(24px, 5vw, 40px); font-weight:900; margin:0;">FEATURED CATEGORIES</h2>
    </div>
  </div>
  
  <div class="ed-marquee-wrapper">
    <div class="ed-marquee-set">
      {{ category_cards }}
    </div>
    <div class="ed-marquee-set ed-mobile-marquee">
      {{ category_cards }}
    </div>
  </div>
</section>

<style>
  .ed-category-card-custom {
    display: block;
    overflow: hidden;
    border: 1px solid var(--ed-line);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  .ed-category-card-custom img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    padding: 24px;
    border-bottom: 1px solid var(--ed-line);
    transition: transform .3s ease;
  }
  .ed-category-card-custom:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  /* Old video hover removed */
    transform: scale(1.04);
  }
  .ed-category-card-custom div {
    padding: 24px;
  }
  .ed-category-card-custom h3 {
    margin: 0 0 8px;
    font-size: 18px;
    letter-spacing: .05em;
    font-weight: 900;
  }
  .ed-category-card-custom p {
    min-height: 40px;
    margin: 0 0 20px;
    color: #333;
    font-size: 13px;
  }
  .ed-category-card-custom span {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .06em;
  }

  /* Desktop Layout */
  @media (min-width: 750px) {
    .ed-marquee-wrapper {
      width: min(100% - 32px, 1360px);
      margin: 40px auto 0;
    }
    .ed-marquee-set {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .ed-mobile-marquee {
      display: none !important;
    }
  }

  /* Mobile Marquee Layout */
  @media (max-width: 749px) {
    .ed-marquee-wrapper {
      display: flex;
      width: 100vw;
      margin-top: 32px;
      gap: 16px;
      padding-left: 16px; /* Offset start so it's not totally flush initially */
    }
    .ed-marquee-set {
      display: flex;
      gap: 16px;
      flex-shrink: 0;
      animation: ed-scroll-marquee 15s linear infinite;
    }
    .ed-category-card-custom {
      width: 75vw;
      flex-shrink: 0;
    }
    
    @keyframes ed-scroll-marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(calc(-100% - 16px)); }
    }
  }
  .ed-video-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
    border-bottom: 1px solid var(--ed-line);
    background: #fff;
  }
  .ed-video-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.3);
    transition: transform .4s cubic-bezier(0.25, 1, 0.5, 1);
    mix-blend-mode: multiply; /* Removes grey background perfectly on white */
  }
  .ed-category-card-custom:hover .ed-video-wrapper video {
    transform: scale(1.38);
  }
</style>

{% schema %}
{ "name": "EDUTHOO categories", "settings": [], "presets": [{ "name": "EDUTHOO categories" }] }
{% endschema %}


