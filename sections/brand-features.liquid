<section class="ed-section ed-brand-features" style="background-color: #fafafa; padding: 80px 0;">
  <div class="ed-container">
    <div class="ed-section-heading" style="text-align: center; margin-bottom: 60px;">
      <p style="font-size: 11px; letter-spacing: 0.12em; font-weight: 800; color: #555;">THE EDUTHOO DIFFERENCE</p>
      <h2 style="font-family: var(--font-serif); font-size: 32px; font-weight: 900; margin-top: 12px;">Why Choose Us</h2>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; text-align: center;">
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">PREMIUM QUALITY</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">Every product is carefully crafted using high-grade materials to ensure maximum durability and a premium feel.</p>
      </div>
      
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">FAST & SECURE DELIVERY</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">We partner with top logistics providers across India to ensure your orders reach you safely and quickly.</p>
      </div>
      
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">CUSTOMER CARE</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">Have questions? Reach out to our dedicated support team at <a href="mailto:eduthooo@gmail.com" style="color: #000; text-decoration: underline;">eduthooo@gmail.com</a></p>
      </div>
    </div>
  </div>
</section>

