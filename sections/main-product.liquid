<section class="ed-section">
  <div class="ed-container ed-product-layout">
          <div class="ed-product-media-gallery">
        <div class="ed-product-media">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" id="MainProductImage" alt="{{ product.title | escape }}">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        {% if product.media.size > 1 %}
          <div class="ed-product-thumbnails">
            {% for media in product.media %}
              <img src="{{ media | image_url: width: 300 }}" alt="{{ product.title | escape }}" onclick="document.getElementById('MainProductImage').src = this.src.replace('width=300', 'width=1200'); document.querySelectorAll('.ed-product-thumbnails img').forEach(img => img.classList.remove('is-active')); this.classList.add('is-active');" class="ed-product-thumb {% if forloop.first %}is-active{% endif %}">
            {% endfor %}
          </div>
        {% endif %}
      </div>
    <div class="ed-product-info">
      <p class="ed-eyebrow">{{ product.type | default: 'EDUTHOO' | escape }}</p>
      <h1>{{ product.title | default: 'EDUTHOO Premium Product' | escape }}</h1>
              {% form 'product', product, id: 'eduthoo-product-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: '' }}">
          
          <div class="ed-quantity-selector">
            <span class="ed-quantity-label">Quantity</span>
            <div class="ed-quantity-controls">
              <button type="button" class="ed-qty-btn" onclick="this.nextElementSibling.stepDown()">-</button>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" readonly>
              <button type="button" class="ed-qty-btn" onclick="this.previousElementSibling.stepUp()">+</button>
            </div>
          </div>
          
          <div class="ed-sticky-purchase-wrapper">
            <button class="ed-purchase-add-new" type="submit" name="add" data-add-button aria-label="Add to cart" {% if product == blank %}disabled{% endif %}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              <span>ADD TO CART</span>
            </button>
            
            <button class="ed-purchase-buy-new" type="button" data-buy-button-direct {% if product == blank or product.selected_or_first_available_variant.available == false %}disabled{% endif %} aria-label="Buy now">
              <span data-buy-label>BUY AT {% if product != blank %}{{ product.selected_or_first_available_variant.price | money }}{% else %}₹2,999{% endif %}</span>
            </button>
          </div>
        {% endform %}
        <div class="ed-description rte">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Experience the perfect blend of modern minimalist design and cutting-edge technology. This premium product is crafted to elevate your everyday lifestyle with uncompromising quality and performance.</p>
        {% endif %}
      </div>
      
      <div class="ed-product-promises">
        <span>Free delivery above ₹999</span>
        <span>7-day easy returns</span>
        <span>Secure checkout</span>
      </div>

      <div class="ed-accordion">
        <details>
          <summary>Details & Specs <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></summary>
          <div class="ed-accordion__content">
            Engineered for perfection, our products undergo rigorous quality testing. Features a sleek matte finish, ergonomic design, and durable materials meant to last.
          </div>
        </details>
        <details>
          <summary>Shipping & Returns <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></summary>
          <div class="ed-accordion__content">
            Enjoy free nationwide shipping on all orders over ₹999. If you're not completely satisfied, return the item within 7 days for a hassle-free refund.
          </div>
        </details>
      </div>
      
    </div>
  </div>
</section>

{% schema %}
{ "name": "Main product", "settings": [] }
{% endschema %}




