{% assign selected_collection = section.settings.collection %}
{% if selected_collection != blank %}
  <section class="ed-section">
    <div class="ed-container">
      <div class="ed-section-heading"><p>{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | default: selected_collection.title | escape }}</h2></div>
      <div class="ed-product-grid">
        {% for product in selected_collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}
      </div>
    </div>
  </section>
{% else %}
  <section class="ed-section">
    <div class="ed-container">
      <div class="ed-section-heading ed-section-heading--split"><div><p>BEST SELLING PRODUCTS</p><h2>BEST OF EDUTHOO</h2></div><a class="ed-button" href="{{ routes.all_products_collection_url }}">VIEW ALL →</a></div>
      <div class="ed-product-grid ed-product-grid--preview">
        <article class="ed-product-card"><div class="ed-product-card__image">{{ 'eduthoo-earbuds.jpg' | asset_url | image_tag: alt: 'EDUTHOO Pro ANC Wireless Earbuds' }}<b>BEST SELLER</b></div><div class="ed-product-card__content"><p>GADGETS</p><h3>EDUTHOO Pro ANC Wireless Earbuds</h3><strong>₹1,999 <s>₹2,999</s></strong><span class="ed-card-button">ADD TO CART</span></div></article>
        <article class="ed-product-card"><div class="ed-product-card__image">{{ 'eduthoo-magsafe-stand.jpg' | asset_url | image_tag: alt: 'EDUTHOO MagSafe stand' }}<b>TRENDING</b></div><div class="ed-product-card__content"><p>TECH</p><h3>EDUTHOO MagSafe 3-in-1 Aluminum Stand</h3><strong>₹2,499 <s>₹3,499</s></strong><span class="ed-card-button">ADD TO CART</span></div></article>
        <article class="ed-product-card"><div class="ed-product-card__image">{{ 'eduthoo-smart-light.jpg' | asset_url | image_tag: alt: 'EDUTHOO Smart Ambient Lamp' }}<b>NEW</b></div><div class="ed-product-card__content"><p>HOME</p><h3>EDUTHOO Smart Cylindrical Ambient Lamp</h3><strong>₹1,499 <s>₹2,199</s></strong><span class="ed-card-button">ADD TO CART</span></div></article>
        <article class="ed-product-card"><div class="ed-product-card__image">{{ 'eduthoo-keyboard.jpg' | asset_url | image_tag: alt: 'EDUTHOO Wireless Keyboard' }}<b>FLAGSHIP</b></div><div class="ed-product-card__content"><p>TECH</p><h3>EDUTHOO Low-Profile Wireless Keyboard</h3><strong>₹3,999 <s>₹5,499</s></strong><span class="ed-card-button">ADD TO CART</span></div></article>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CURATED FOR YOU" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BEST OF EDUTHOO" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
