{% assign selected_collection = section.settings.collection %}
{% assign display_products = selected_collection.products %}

{% if display_products == blank or display_products.size == 0 %}
  {% assign display_products = collections.all.products | sort: 'published_at' | reverse %}
{% endif %}

<section class="ed-section">
  <div class="ed-container">
    <div class="ed-section-heading">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | default: selected_collection.title | escape }}</h2>
    </div>
    
    <div class="ed-product-grid">
      {% for product in display_products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        <!-- Fallback if absolutely 0 products exist in the store -->
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: #fafafa; border: 1px dashed #ccc;">
          <p>No products found. Add products in your Shopify Admin to see them here.</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW ARRIVALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "BEST OF EDUTHOO" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
