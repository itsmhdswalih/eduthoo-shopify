<section class="ed-store-policies" style="padding: 64px 0; background: #fff;">
  <div class="ed-container">
    <h2 style="text-align: center; font-size: 24px; letter-spacing: -0.02em; margin-bottom: 40px; text-transform: uppercase; font-weight: 900;">Store Policies</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">

      <div style="padding: 32px; background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border: 1px solid var(--ed-line); transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 32px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.04)';">
        <h3 style="font-size: 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-weight: 800;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          Shipping Policy
        </h3>
        <p style="font-size: 13px; color: #555; line-height: 1.6; margin: 0;">We are committed to delivering your order quickly. Your product will be delivered to your doorstep within <strong>7 days</strong> of placing the order.</p>
      </div>

      <div style="padding: 32px; background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border: 1px solid var(--ed-line); transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 32px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.04)';">
        <h3 style="font-size: 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-weight: 800;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
          Payment Options
        </h3>
        <p style="font-size: 13px; color: #555; line-height: 1.6; margin: 0;">We currently offer <strong>Cash on Delivery (COD) ONLY</strong>. There are no online payment options available at this time.</p>
      </div>

      <div style="padding: 32px; background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border: 1px solid var(--ed-line); transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 32px rgba(0,0,0,0.08)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.04)';">
        <h3 style="font-size: 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-weight: 800;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"></path><path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"></path><path d="M12 3v6"></path></svg>
          Returns & Replacements
        </h3>
        <p style="font-size: 13px; color: #555; line-height: 1.6; margin: 0;">We have a strict No-Return policy. Replacements are only provided for damaged items, for which an <strong>unboxing video is strictly mandatory</strong>. <br><br><a href="/pages/contact" style="color: #000; text-decoration: underline; font-weight: bold;">Contact Us</a> for any support.</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store Policies",
  "presets": [{ "name": "Store Policies" }]
}
{% endschema %}
