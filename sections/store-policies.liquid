<section class="ed-section ed-store-policies" style="background-color: #fafafa; padding: 80px 0;">
  <div class="ed-container">
    <div class="ed-section-heading" style="text-align: center; margin-bottom: 60px;">
      <p style="font-size: 11px; letter-spacing: 0.12em; font-weight: 800; color: #555;">OUR COMMITMENT</p>
      <h2 style="font-family: var(--font-serif); font-size: 32px; font-weight: 900; margin-top: 12px;">Store Policies</h2>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; text-align: center;">
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">SHIPPING POLICY</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">Your product will be delivered to your doorstep within <strong>7 days</strong> of placing the order.</p>
      </div>
      
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">PAYMENT OPTIONS</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">We offer <strong>Cash on Delivery (COD) ONLY</strong>. There are no online payment options available at this time.</p>
      </div>
      
      <div class="ed-feature-card">
        <div style="width: 48px; height: 48px; background: #000; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"></path><path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"></path><path d="M12 3v6"></path></svg>
        </div>
        <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: 0.05em;">RETURNS & REPLACEMENTS</h3>
        <p style="font-size: 14px; color: #555; line-height: 1.6;">Replacements are only provided for damaged items, for which an <strong>unboxing video is mandatory</strong>. <a href="/pages/contact" style="color: #000; text-decoration: underline; font-weight: bold;">Contact Us</a> for support.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store Policies",
  "presets": [{ "name": "Store Policies" }]
}
{% endschema %}
