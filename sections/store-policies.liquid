<section class="ed-store-policies" style="padding: 40px 0; background: #fafafa;">
  <div class="ed-container">
    <div class="ed-policy-card" style="padding: 40px 30px; background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.04); border: 1px solid var(--ed-line); text-align: center; max-width: 800px; margin: 0 auto;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 16px;"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><path d="m3 9 2.45-4.9A2 2 0 0 1 7.24 3h9.52a2 2 0 0 1 1.8 1.1L21 9"/><path d="M12 3v6"/></svg>
      <h2 style="font-size: 20px; margin: 0 0 16px; letter-spacing: -0.02em;">Return & Contact Policy</h2>
      <p style="font-size: 14px; color: #555; line-height: 1.6; margin: 0 0 16px;">
        We strictly follow a <strong>No-Return Policy</strong> under normal circumstances. If you face any critical issues with your product and wish to request a return, you must contact our support.
      </p>
      <p style="font-size: 14px; color: #333; line-height: 1.6; margin: 0; padding: 16px; background: #f9f9f9; border-radius: 12px;">
        <strong>How to request:</strong> Email us at <a href="mailto:eduthooo@gmail.com" style="color:#000; text-decoration:underline;">eduthooo@gmail.com</a> or call our support number. <br>
        Please provide your order details and <strong>your contact number</strong> in the email. Our team will review your request and contact you directly.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store Policies",
  "presets": [{ "name": "Store Policies" }]
}
{% endschema %}
