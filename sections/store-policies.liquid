<section class="ed-section ed-store-policies" style="background-color: #fafafa; padding: 80px 0;">
  <div class="ed-container" style="max-width: 800px; margin: 0 auto;">
    <div class="ed-section-heading" style="text-align: center; margin-bottom: 40px;">
      <p style="font-size: 11px; letter-spacing: 0.12em; font-weight: 800; color: #555; text-transform: uppercase;">OUR COMMITMENT</p>
      <h2 style="font-family: var(--font-serif); font-size: clamp(28px, 4vw, 40px); font-weight: 900; margin-top: 12px; letter-spacing: -0.02em;">Store Policies</h2>
    </div>
    
    <div class="ed-faq-accordion" style="display: flex; flex-direction: column; gap: 16px;">
      
      <!-- Shipping Policy -->
      <div class="ed-faq-item">
        <button class="ed-faq-trigger">
          <span class="ed-faq-title">Shipping Policy</span>
          <div class="ed-faq-icon-wrapper">
            <svg class="ed-faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
        </button>
        <div class="ed-faq-content">
          <div class="ed-faq-content-inner">
            Your product will be delivered to your doorstep within <strong>7 days</strong> of placing the order. We partner with secure and fast logistics.
          </div>
        </div>
      </div>

      <!-- Payment Options -->
      <div class="ed-faq-item">
        <button class="ed-faq-trigger">
          <span class="ed-faq-title">Payment Options</span>
          <div class="ed-faq-icon-wrapper">
            <svg class="ed-faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
        </button>
        <div class="ed-faq-content">
          <div class="ed-faq-content-inner">
            We currently offer <strong>Cash on Delivery (COD) ONLY</strong>. There are no online payment options available at this time. Please hand over the exact cash amount to our delivery executive.
          </div>
        </div>
      </div>

      <!-- Returns & Replacements -->
      <div class="ed-faq-item">
        <button class="ed-faq-trigger">
          <span class="ed-faq-title">Returns & Replacements</span>
          <div class="ed-faq-icon-wrapper">
            <svg class="ed-faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
        </button>
        <div class="ed-faq-content">
          <div class="ed-faq-content-inner">
            We have a strict No-Return policy. Replacements are only provided for damaged items, for which an <strong>unboxing video is strictly mandatory</strong>. <a href="/pages/contact" style="color: #000; text-decoration: underline; font-weight: bold;">Contact Us</a> for any support regarding damaged items.
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .ed-faq-item {
    background: #f0f2f5;
    border-radius: 50px;
    transition: all 0.3s ease;
    overflow: hidden;
  }
  .ed-faq-item.is-open {
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.06);
  }
  .ed-faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px 12px 28px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
  }
  .ed-faq-title {
    font-size: 15px;
    font-weight: 800;
    color: #000;
  }
  .ed-faq-icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: #000;
    flex-shrink: 0;
  }
  .ed-faq-item.is-open .ed-faq-icon-wrapper {
    background: #f0f2f5;
  }
  .ed-faq-icon {
    transition: transform 0.3s ease;
  }
  .ed-faq-item.is-open .ed-faq-icon {
    transform: rotate(45deg);
  }
  .ed-faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ed-faq-content-inner {
    padding: 0 28px 24px 28px;
    font-size: 14px;
    line-height: 1.6;
    color: #555;
  }
  @media (max-width: 749px) {
    .ed-faq-trigger { padding: 12px 12px 12px 20px; }
    .ed-faq-title { font-size: 14px; }
    .ed-faq-content-inner { padding: 0 20px 20px 20px; font-size: 13px; }
    .ed-faq-icon-wrapper { width: 36px; height: 36px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const triggers = document.querySelectorAll('.ed-faq-trigger');
    triggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const item = this.closest('.ed-faq-item');
        const content = item.querySelector('.ed-faq-content');
        
        const isOpen = item.classList.contains('is-open');

        // Close all items
        document.querySelectorAll('.ed-faq-item').forEach(otherItem => {
          otherItem.classList.remove('is-open');
          const otherContent = otherItem.querySelector('.ed-faq-content');
          if(otherContent) otherContent.style.maxHeight = null;
        });

        // Open the clicked one if it wasn't already open
        if (!isOpen) {
          item.classList.add('is-open');
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Store Policies",
  "presets": [{ "name": "Store Policies" }]
}
{% endschema %}
